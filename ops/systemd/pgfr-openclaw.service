[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference OpenClaw Gateway
Wants=network-online.target
Wants=pgfr-seam.service
After=network-online.target pgfr-seam.service

[Service]
Type=simple
WorkingDirectory=__PGFR_REPO__
EnvironmentFile=__PGFR_HOME__/.config/pgfr-spine/openclaw.env
EnvironmentFile=-__PGFR_HOME__/.openclaw/secrets.env
ExecStart=__PGFR_REPO__/ops/gw.sh --bind loopback
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__PGFR_HOME__/.policy-gated-factory-robot-orchestrator-reference/openclaw __PGFR_HOME__/pgfr-journal
UMask=0077

[Install]
WantedBy=default.target
