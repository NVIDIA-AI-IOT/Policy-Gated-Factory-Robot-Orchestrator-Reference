[Unit]
Description=Industrial Claw pinned perception VLM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__IC_REPO__
EnvironmentFile=__IC_HOME__/.config/ic-spine/vlm.env
ExecStart=__IC_REPO__/ops/launch-perception-vlm.sh --run
ExecStartPost=__IC_REPO__/ops/launch-perception-vlm.sh --wait
ExecStop=/usr/bin/docker stop -t 30 ${IC_VLM_CONTAINER}
Restart=on-failure
RestartSec=5
TimeoutStartSec=960
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__IC_HOME__/.cache/huggingface
UMask=0077

[Install]
WantedBy=default.target
