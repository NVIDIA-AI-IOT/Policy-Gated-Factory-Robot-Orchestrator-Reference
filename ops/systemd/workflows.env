PGFR_GROOT_PARALLEL_ENABLED=0
PGFR_GROOT_FLEXIBLE_ORDER=0
PGFR_SKILLS_DIR=__PGFR_REPO__/skills
PGFR_WORKFLOWS_CORS=http://127.0.0.1:8600,http://localhost:8600
