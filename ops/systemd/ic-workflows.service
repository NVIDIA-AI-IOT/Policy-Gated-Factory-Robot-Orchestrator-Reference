[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference gated workflow runner
Wants=network-online.target ic-seam.service
After=network-online.target ic-seam.service

[Service]
Type=simple
WorkingDirectory=__IC_REPO__/servers/ic-workflows
EnvironmentFile=__IC_HOME__/.config/ic-spine/workflows.env
EnvironmentFile=-__IC_HOME__/.openclaw/secrets.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__IC_REPO__/servers/ic-workflows/.venv/bin/ic-workflows
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__IC_REPO__/servers/ic-workflows/workflows __IC_REPO__/skills
UMask=0077

[Install]
WantedBy=default.target
