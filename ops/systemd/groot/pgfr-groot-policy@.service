[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference GR00T policy server (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__PGFR_HOME__/groot_shadow/Isaac-GR00T
EnvironmentFile=__PGFR_HOME__/.config/pgfr-spine/groot/%i.env
Environment=PYTHONUNBUFFERED=1
# Reject unsafe pickle fallback, including torch.export.load archives.
Environment=TORCH_FORCE_WEIGHTS_ONLY_LOAD=1
UnsetEnvironment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD
Environment=NO_ALBUMENTATIONS_UPDATE=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HOME=__PGFR_HOME__/policy-gated-factory-robot-orchestrator-reference-models/hf-home
Environment=HF_TOKEN_PATH=__PGFR_HOME__/policy-gated-factory-robot-orchestrator-reference-models/hf-home/token
Environment=CUDA_HOME=/usr/local/cuda-13.0
Environment=CUDA_PATH=/usr/local/cuda-13.0
Environment=TRITON_PTXAS_PATH=/usr/local/cuda-13.0/bin/ptxas
Environment=LD_LIBRARY_PATH=/usr/local/cuda-13.0/targets/sbsa-linux/lib:__PGFR_HOME__/groot_shadow/Isaac-GR00T/.venv/lib/python3.12/site-packages/nvidia/cu13/lib:__PGFR_HOME__/groot_shadow/Isaac-GR00T/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:__PGFR_HOME__/groot_shadow/Isaac-GR00T/.venv/lib/python3.12/site-packages/torch/lib
ExecStartPre=__PGFR_REPO__/ops/verify-groot-models.sh ${MODEL_PATH} ${PGFR_CHECKPOINT_FINGERPRINT}
ExecStart=__PGFR_HOME__/groot_shadow/Isaac-GR00T/.venv/bin/python gr00t/eval/run_gr00t_server.py --embodiment-tag OXE_DROID_RELATIVE_EEF_RELATIVE_JOINT --host 127.0.0.1 --port ${POLICY_PORT} --model-path ${MODEL_PATH}
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=pgfr-groot-shared-stack.target
