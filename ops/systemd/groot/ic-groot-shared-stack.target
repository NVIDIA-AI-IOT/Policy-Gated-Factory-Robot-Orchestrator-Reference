[Unit]
Description=Industrial Claw one-checkpoint two-instance B=1 GR00T stack
Requires=ic-groot-policy@shared-left.service
Requires=ic-groot-policy@shared-right.service
Requires=ic-groot-relay@shared-left.service
Requires=ic-groot-relay@shared-right.service
After=ic-groot-policy@shared-left.service ic-groot-policy@shared-right.service

[Install]
WantedBy=default.target
