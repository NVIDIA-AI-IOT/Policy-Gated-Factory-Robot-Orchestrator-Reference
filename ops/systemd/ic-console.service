[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference live operator console
Wants=network-online.target ic-seam.service ic-chat.service ic-workflows.service ic-gpu-exporter.service
After=network-online.target ic-seam.service ic-chat.service ic-workflows.service ic-gpu-exporter.service

[Service]
Type=simple
WorkingDirectory=__IC_REPO__/ic-console
EnvironmentFile=__IC_HOME__/.config/ic-spine/console.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__IC_REPO__/ic-console/.venv/bin/ic-console
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=default.target
