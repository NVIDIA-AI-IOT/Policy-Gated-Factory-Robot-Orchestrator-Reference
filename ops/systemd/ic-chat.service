[Unit]
Description=Industrial Claw Chat Gateway
Wants=network-online.target
Wants=ic-seam.service ic-openclaw.service
After=network-online.target ic-seam.service ic-openclaw.service

[Service]
Type=simple
WorkingDirectory=__IC_REPO__/servers/ic-chat
EnvironmentFile=__IC_HOME__/.config/ic-spine/chat.env
EnvironmentFile=-__IC_HOME__/.openclaw/secrets.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__IC_REPO__/servers/ic-chat/.venv/bin/ic-chat
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__IC_HOME__/.local/share/ic-spine/chat-sessions
UMask=0077

[Install]
WantedBy=default.target
