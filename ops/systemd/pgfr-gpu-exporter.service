[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference GPU telemetry exporter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__PGFR_REPO__
EnvironmentFile=__PGFR_HOME__/.config/pgfr-spine/gpu.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 __PGFR_REPO__/ops/pgfr_gpu_exporter.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__PGFR_HOME__/.local/share/pgfr-spine/gpu
UMask=0077

[Install]
WantedBy=default.target
