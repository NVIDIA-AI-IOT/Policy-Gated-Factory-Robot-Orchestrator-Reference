[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference ROS 2 floor Seam
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__IC_REPO__/ic-spine
EnvironmentFile=__IC_HOME__/.config/ic-spine/seam.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__IC_REPO__/ic-spine/.venv/bin/policy_gated_factory_robot_orchestrator_reference serve --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# Fast DDS uses netlink to enumerate the physical NIC.  Without AF_NETLINK the
# ROS graph is visible but the participant falls back to loopback and receives
# no cross-host /ic or camera payloads.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=__IC_HOME__/ic-journal __IC_HOME__/.ros
UMask=0077

[Install]
WantedBy=default.target
