IC_CHAT_BACKEND=openai
IC_CHAT_HOST=127.0.0.1
IC_CHAT_CORS=http://127.0.0.1:8600,http://localhost:8600
# Required when IC_CHAT_HOST is changed to a non-loopback address.
IC_CHAT_TOKEN=
IC_CHAT_MODEL=replace-with-your-model-id
IC_CHAT_MODEL_URL=http://127.0.0.1:8000
IC_CHAT_MAX_TURNS=48
IC_CHAT_PORT=8620
IC_FLOOR_SERVICE=http://127.0.0.1:8766
IC_CHAT_SESSIONS_DIR=__IC_HOME__/.local/share/ic-spine/chat-sessions
IC_OPENCLAW_URL=http://127.0.0.1:18790
IC_OPENCLAW_CONFIG=__IC_HOME__/.industrial-claw/openclaw/openclaw.json
IC_OPENCLAW_AGENT_MODEL=openclaw/ic-console
IC_OPENCLAW_NATIVE_GATEWAY=1
IC_OPENCLAW_TIMEOUT_S=900
IC_OPENCLAW_WS_URL=ws://127.0.0.1:18790
IC_OPENCLAW_AGENT_ID=ic-console
