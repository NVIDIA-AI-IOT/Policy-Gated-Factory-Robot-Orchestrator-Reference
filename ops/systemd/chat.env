PGFR_CHAT_BACKEND=openai
PGFR_CHAT_HOST=127.0.0.1
PGFR_CHAT_CORS=http://127.0.0.1:8600,http://localhost:8600
# Required when PGFR_CHAT_HOST is changed to a non-loopback address.
PGFR_CHAT_TOKEN=
PGFR_CHAT_MODEL=replace-with-your-model-id
PGFR_CHAT_MODEL_URL=http://127.0.0.1:8000
PGFR_CHAT_MAX_TURNS=48
PGFR_CHAT_PORT=8620
PGFR_FLOOR_SERVICE=http://127.0.0.1:8766
PGFR_CHAT_SESSIONS_DIR=__PGFR_HOME__/.local/share/pgfr-spine/chat-sessions
PGFR_OPENCLAW_URL=http://127.0.0.1:18790
PGFR_OPENCLAW_CONFIG=__PGFR_HOME__/.policy-gated-factory-robot-orchestrator-reference/openclaw/openclaw.json
PGFR_OPENCLAW_AGENT_MODEL=openclaw/pgfr-console
PGFR_OPENCLAW_NATIVE_GATEWAY=1
PGFR_OPENCLAW_TIMEOUT_S=900
PGFR_OPENCLAW_WS_URL=ws://127.0.0.1:18790
PGFR_OPENCLAW_AGENT_ID=pgfr-console
