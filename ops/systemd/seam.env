IC_FLOOR_BACKEND=ros2
IC_FLOOR_SCENE=__IC_REPO__/ic-spine/configs/scene.our_demo.yaml
IC_JOURNAL_DIR=__IC_HOME__/ic-journal
IC_PERCEIVE_MODE=vision_only
IC_VLM_URL=http://127.0.0.1:8001
IC_VLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-NVFP4-QAD
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
AMENT_PREFIX_PATH=/opt/ros/jazzy
PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages
LD_LIBRARY_PATH=/opt/ros/jazzy/lib/aarch64-linux-gnu:/opt/ros/jazzy/lib
PATH=/opt/ros/jazzy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
