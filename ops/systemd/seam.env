PGFR_FLOOR_BACKEND=ros2
PGFR_FLOOR_SCENE=__PGFR_REPO__/pgfr-spine/configs/scene.our_demo.yaml
PGFR_JOURNAL_DIR=__PGFR_HOME__/pgfr-journal
PGFR_GROOT_PARALLEL_ENABLED=0
PGFR_GROOT_FLEXIBLE_ORDER=0
PGFR_PERCEIVE_MODE=vision_only
PGFR_VLM_URL=http://127.0.0.1:8001
PGFR_VLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-NVFP4-QAD
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=__PGFR_REPO__/ops/fastdds-multi-host.xml
AMENT_PREFIX_PATH=/opt/ros/jazzy
PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages
LD_LIBRARY_PATH=/opt/ros/jazzy/lib/aarch64-linux-gnu:/opt/ros/jazzy/lib
PATH=/opt/ros/jazzy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
