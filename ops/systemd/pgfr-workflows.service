[Unit]
Description=Policy-Gated Factory Robot Orchestrator Reference gated workflow runner
Wants=network-online.target pgfr-seam.service
After=network-online.target pgfr-seam.service

[Service]
Type=simple
WorkingDirectory=__PGFR_REPO__/servers/pgfr-workflows
EnvironmentFile=__PGFR_HOME__/.config/pgfr-spine/workflows.env
EnvironmentFile=-__PGFR_HOME__/.openclaw/secrets.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__PGFR_REPO__/servers/pgfr-workflows/.venv/bin/pgfr-workflows
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__PGFR_REPO__/servers/pgfr-workflows/workflows __PGFR_REPO__/skills
UMask=0077

[Install]
WantedBy=default.target
