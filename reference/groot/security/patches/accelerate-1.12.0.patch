+def _resolve_checkpoint_shards(index, checkpoint_folder):
+    """Validate shard paths and file types before opening checkpoint weights.
+
+    Accept ordinary contained files and the Hugging Face Hub's content-addressed
+    snapshot-to-blob symlinks. The checkpoint/cache must not be writable by an
+    untrusted process while loading; this check is not a filesystem sandbox.
+    """
+    if not isinstance(index, dict):
+        raise ValueError("The checkpoint index must be a JSON object.")
+    weight_map = index.get("weight_map", index)
+    if not isinstance(weight_map, dict) or not weight_map:
+        raise ValueError("The checkpoint weight_map must be a non-empty JSON object.")
+    for shard in weight_map.values():
+        if not isinstance(shard, str) or not shard or "\0" in shard:
+            raise ValueError("Every checkpoint shard name must be a non-empty string.")
+
+    checkpoint_folder = os.path.realpath(checkpoint_folder)
+    snapshot_folder = checkpoint_folder
+    blob_folder = None
+    while True:
+        snapshot_parent = os.path.dirname(snapshot_folder)
+        if os.path.basename(snapshot_parent) == "snapshots" and re.fullmatch(
+            r"[0-9a-f]{40}", os.path.basename(snapshot_folder)
+        ):
+            blob_folder = os.path.join(os.path.dirname(snapshot_parent), "blobs")
+            break
+        if snapshot_parent == snapshot_folder:
+            break
+        snapshot_folder = snapshot_parent
+
+    checkpoint_files = []
+    for shard in sorted(set(weight_map.values())):
+        if (
+            ntpath.splitdrive(shard)[0]
+            or os.path.isabs(shard)
+            or "\\" in shard
+            or ".." in shard.split("/")
+        ):
+            raise ValueError(f"Unsafe checkpoint shard path: {shard!r}")
+        candidate = os.path.join(checkpoint_folder, shard)
+        resolved = os.path.realpath(candidate)
+        contained = os.path.commonpath([checkpoint_folder, resolved]) == checkpoint_folder
+        hub_blob = (
+            blob_folder is not None
+            and os.path.islink(candidate)
+            and os.path.dirname(resolved) == blob_folder
+            and re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", os.path.basename(resolved))
+        )
+        if not contained and not hub_blob:
+            raise ValueError(f"Checkpoint shard escapes its directory: {shard!r}")
+        if not os.path.isfile(candidate):
+            raise ValueError(f"Checkpoint shard must be a regular file: {shard!r}")
+        checkpoint_files.append(candidate)
+    return checkpoint_files
+
